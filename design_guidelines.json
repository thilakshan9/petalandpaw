  "instructions_to_main_agent": [
    "Install 'lucide-react' if not present.",
    "Update tailwind.config.js with the specified color palette and fonts.",
    "Create a 'Layout' component that wraps pages with the Navbar and Footer, applying the global background color #FAF9F6.",
    "For the 'Create Your Own Bouquet' page, use HTML5 Drag and Drop API or just click-to-add logic for simplicity if libraries are restricted.",
    "Ensure all text has sufficient contrast. Use #2C2C2C for body text, never pure black.",
    "Use 'Playfair Display' for all Headings (H1-H4) to achieve the premium aesthetic.",
    "Use 'sonner' for toast notifications.",
    "Add 'data-testid' to all interactive elements."
  ]
